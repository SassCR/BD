-- CRIANDO TABELAS
CREATE TABLE clientes( 
 id_cliente SERIAL PRIMARY KEY,
 nome VARCHAR(100),
 cidade VARCHAR(100),
 estado VARCHAR(50),
 idade INT,
 renda NUMERIC(10,2)
);


