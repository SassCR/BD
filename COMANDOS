-- AQUI ESTOU PESQUISANDO PESSOAS COM A IDADE ENTRE 20 A 30 ANOS, TEM ESSAS DUAS MANEIRAS DE PESQUISAR.
ELECT * FROM clientes 
WHERE idade BETWEEN 20 and 30;

-- SEGUNDA FORMA
SELECT * FROM clientes 
WHERE idade >= 20 and idade <= 30;

-- TEM DESSA MANEIRA PARA ACHAR PESSOAS QUE FORAM CRIADAS DEPOIS
SELECT * FROM clientes 
WHERE idade NOT BETWEEN 20 AND 30

-- SEGUNDA MANEIRA
SELECT * FROM clientes
WHERE idade < 20 or idade > 30

-- AGORA ESTOU PESQUISANDO OS CLIENTES PELOS ESTADOS
SELECT * FROM clientes
WHERE estado IN ('MS', 'SP')

-- AGORA ESTOU PESQUISANDO TODOS OS CLIENTES QUE SÃO DE QUALQUER ESTADO MENOS DE SP
SELECT * FROM clientes 
WHERE estado NOT IN ('SP')

-- like -> buscar algo que começa ou termina com um caracter

SELECT * FROM clientes 
WHERE nome LIKE 'T%'

-- TERMINA
SELECT * FROM clientes 
WHERE nome LIKE '%a'

--AGORA CAÇANDO OS DOIS QUE COMEÇA E TERMINA
SELECT * FROM clientes 
WHERE nome LIKE 'T%' AND nome LIKE '%o'

--Segunda maneira
SELECT * FROM clientes 
WHERE nome ILIKE 'T%k'

--Agora pelo começo do nome
SELECT * FROM clientes 
WHERE nome LIKE 'Ton%'
