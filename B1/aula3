--OPERADORES
--AND
SELECT * FROM alunos
WHERE idade >= 18 AND curso_id = 1 -- Eu busquei todos os alunos que tem 18 ou mais e cursa informatica

--OR
SELECT * FROM alunos
WHERE curso_id = 1 OR curso_id = 2

--NOT
SELECT * FROM alunos
WHERE NOT curso_id = 1 

--IS NULL
SELECT * FROM alunos WHERE telefone IS NULL --Aqui estou buscando todos os alunos que não tem telefone

--IS NOT NULL
SELECT * FROM alunos WHERE telefone IS NOT NULL --Aqui estou buscando todos os alunos que tem telefone

--INNER JOIN apenas alunos com curso correspondente
SELECT alunos.nome AS alu, cursos.nome AS cur
FROM alunos
INNER JOIN cursos ON alunos.curso_id = cursos.id
ORDER BY alu --aqui é o apelido que dei

--INNER JOIN SEM O AS /APELIDO dessa maneira ele puxa dois nome porém um de curso e outro de alunos
SELECT alunos.nome, cursos.nome
FROM alunos
INNER JOIN cursos ON alunos.curso_id = cursos.id

--LEFT JOIN todos os alunos, mesmo sem curso correspondente 
SELECT alunos.nome AS alunos, cursos.nome AS curso
FROM alunos
LEFT JOIN cursos ON alunos.curso_id = cursos.id
ORDER BY alunos

--RIGHT JOIN todos os cursos, mesmo sem alunos matriculados
SELECT alunos.nome AS aluno, cursos.nome AS curso
FROM alunos
RIGHT JOIN cursos ON alunos.curso_id = cursos.id
ORDER BY alunos

--FULL JOIN todas as combinações com correspodencia
SELECT alunos.nome AS aluno, cursos.nome AS curso
FROM alunos
FULL JOIN cursos ON alunos.curso_id = cursos.id
ORDER BY alunos, cursos

--CROSS JOIN todas as combinações possiveis
SELECT alunos.nome AS aluno, cursos.nome AS curso
FROM alunos
CROSS JOIN cursos 
ORDER BY alunos, cursos
LIMIT 20 --Limita o resultado para não gerar muitos resultados

--COUNT exibi um total
SELECT COUNT (*) AS total_alunos FROM alunos

SELECT
	curso_id,
	COUNT (*) AS quantidade,
	SUM(salario) AS total_salario,
	AVG(salario) AS media_salarial
FROM alunos
GROUP BY curso_id
ORDER BY curso_id

